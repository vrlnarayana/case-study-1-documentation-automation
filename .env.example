# Documentation Automation System - Environment Configuration

# ============================================================================
# LLM Configuration with Fallback Support
# ============================================================================

# Primary Model (Qwen)
LLM_PROVIDER=qwen
LLM_BASE_URL=http://52.140.126.42:4000/v1
LLM_API_KEY=sk-x0DiyZobb2HVL2HMz6Yvew
LLM_MODEL=qwen3.8-27b

# Fallback Model (used when primary fails)
# Can be different model on same endpoint or different provider entirely
FALLBACK_LLM_PROVIDER=kimi
FALLBACK_LLM_BASE_URL=http://52.140.126.42:4000/v1
FALLBACK_LLM_API_KEY=sk-x0DiyZobb2HVL2HMz6Yvew
FALLBACK_LLM_MODEL=kimi-k2.5-aws

# Alternative: OpenAI Configuration
# Uncomment below and comment out Qwen section above to use OpenAI
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-key
# LLM_MODEL=gpt-4
# FALLBACK_LLM_MODEL=gpt-3.5-turbo

# ============================================================================
# MCP Server Configuration
# ============================================================================

MCP_SERVER_PATH=./app/mcp_server/server.py
MCP_TRANSPORT=stdio

# ============================================================================
# Application Settings
# ============================================================================

LOG_LEVEL=INFO
OUTPUT_DIR=./outputs
AUDIT_LOG_PATH=./outputs/audit.log

# Guardrails (Prompt 7)
CONFIDENCE_THRESHOLD=0.7
MAX_RETRIES=3
